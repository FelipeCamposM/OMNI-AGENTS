{
  "productName": "OMNI AGENTS",
  "version": "0.2.0",
  "identifier": "com.omni.agents",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OMNI AGENTS",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https://*.ytimg.com https://img.youtube.com https://*.ggpht.com; connect-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost ipc: http://ipc.localhost; media-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/omni-engine"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RTI4QzUyMkQ3MjYyN0IKUldSN1luSXRVb3ppVmI0YmhoSlFRSHRXN3RBaGw5dmdtVUw3N242UGJ4L2hsVjFoWmx3ZS9Lb2sK",
      "endpoints": [
        "https://github.com/FelipeCamposM/OMNI-AGENTS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
