{
  "identifier": "default",
  "description": "Default capability for OMNI AGENTS",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": ["**"] },
    "notification:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-icon",
    "core:window:allow-is-focused",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    { "identifier": "opener:allow-open-path", "allow": [
      { "path": "**/*.pdf" },
      { "path": "**/*.doc" },
      { "path": "**/*.docx" },
      { "path": "**/*.odt" },
      { "path": "**/*.rtf" },
      { "path": "**/*.xls" },
      { "path": "**/*.xlsx" },
      { "path": "**/*.ods" },
      { "path": "**/*.csv" },
      { "path": "**/*.ppt" },
      { "path": "**/*.pptx" },
      { "path": "**/*.odp" },
      { "path": "**/*.zip" },
      { "path": "**/*.rar" },
      { "path": "**/*.7z" },
      { "path": "**/*.png" },
      { "path": "**/*.jpg" },
      { "path": "**/*.jpeg" },
      { "path": "**/*.gif" },
      { "path": "**/*.webp" },
      { "path": "**/*.mp3" },
      { "path": "**/*.wav" },
      { "path": "**/*.mp4" },
      { "path": "**/*.mov" },
      { "path": "**/*.mkv" }
    ] },
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://*" },
      { "url": "http://*" },
      { "url": "https://login.tailscale.com/*" },
      { "url": "https://tailscale.com/*" },
      { "url": "https://code.claude.com/*" },
      { "url": "https://learn.chatgpt.com/*" },
      { "url": "https://cursor.com/*" },
      { "url": "https://*.ts.net/*" },
      { "url": "http://100.*/*" },
      { "url": "http://localhost:*/*" }
    ] }
  ]
}
