{
  "name": "camps-utils",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts\\setup.ps1",
    "setup:dev": "powershell -ExecutionPolicy Bypass -File scripts\\setup.ps1 -DevOnly",
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "node scripts/sync-version.mjs && tauri build && node scripts/collect-installers.mjs",
    "build:vite": "tsc && vite build",
    "build:python": "python python/build.py",
    "build:all": "npm run build:python && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "installers": "node scripts/collect-installers.mjs",
    "release": "node scripts/make-latest-json.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.30.0",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^6.2.108",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9",
    "rehype-sanitize": "^6",
    "remark-gfm": "^4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^14",
    "@testing-library/user-event": "^14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "jsdom": "^24",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^1"
  }
}
